# Let members of plugdev change the Monster keyboard color/brightness
# (writes are limited by the driver to EC 0x767 and 0x769-0x76B).
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="monster::kbd_backlight", \
  RUN+="/usr/bin/chgrp plugdev %S%p/color %S%p/brightness %S%p/multi_intensity", \
  RUN+="/usr/bin/chmod g+w %S%p/color %S%p/brightness %S%p/multi_intensity"
